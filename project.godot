; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="StarfallDepths"
run/main_scene="res://ui/main_menu.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"
; m4-k1 版本单源：与 export_presets.cfg 三处（Android version/name+code、Windows
; file/product_version）强一致（tests/unit/test_version_consistency.gd 双向断言）。
; code 递增规则见 docs/superpowers/reports/m3-export-final.md §1（100 = 1.0.0 基线）。
config/version="1.0.0"
config/version_code=100

[autoload]

EventBus="*res://autoload/event_bus.gd"
GameDB="*res://autoload/game_db.gd"
RngSvc="*res://autoload/rng_svc.gd"
RunState="*res://autoload/run_state.gd"
SaveSystem="*res://autoload/save_system.gd"
AudioMgr="*res://autoload/audio_mgr.gd"
SceneRouter="*res://autoload/scene_router.gd"
Fx="*res://autoload/fx.gd"
Telemetry="*res://core/meta/telemetry.gd"
DeathRecorder="*res://core/meta/death_recorder.gd"
CodexSystem="*res://core/meta/codex_system.gd"
AchievementSystem="*res://core/meta/achievement_system.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("gdUnit4")

[gui]

theme/custom="res://ui/m3_theme.tres"

